<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/set_number_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintBaseline_toBaselineOf="@+id/reps_edit_text"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1." />

    <TextView
        android:id="@+id/reps_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Reps:"
        app:layout_constraintBaseline_toBaselineOf="@+id/reps_edit_text"
        app:layout_constraintStart_toEndOf="@id/set_number_text_view" />

    <EditText
        android:id="@+id/reps_edit_text"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:hint="8-12"
        android:inputType="text"
        android:minHeight="48dp"
        app:layout_constraintStart_toEndOf="@id/reps_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/wt_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Wt:"
        app:layout_constraintBaseline_toBaselineOf="@+id/weight_edit_text"
        app:layout_constraintStart_toEndOf="@id/reps_edit_text" />

    <EditText
        android:id="@+id/weight_edit_text"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:hint="100"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        app:layout_constraintStart_toEndOf="@id/wt_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/lbs_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="lbs"
        app:layout_constraintBaseline_toBaselineOf="@+id/weight_edit_text"
        app:layout_constraintStart_toEndOf="@id/weight_edit_text" />

</androidx.constraintlayout.widget.ConstraintLayout>